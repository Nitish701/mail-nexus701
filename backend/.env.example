# ============================================================
# Mail-Nexus Backend Environment Configuration Example
# ============================================================

# Maximum raw email payload size in bytes (default: 52428800 = 50 MiB)
# Applies to the entire raw RFC822 email stream including headers, body, and attachments.
MAIL_NEXUS_MAX_EMAIL_BYTES=52428800

# Optional webhook shared secret. When set, requests to /webhooks/email or
# /api/v1/inbound must supply header: Authorization: Bearer <secret>
# WEBHOOK_SECRET=your-secret-token-here

# SQLAlchemy database connection string (default: SQLite in backend root)
# MAIL_NEXUS_DATABASE_URL=sqlite:///mail_nexus.db

# Machine Learning Body Model configuration
# MAIL_NEXUS_MODEL_PATH=models/body_model.joblib
# MAIL_NEXUS_BODY_MODEL_MODE=auto

# YARA scanning configuration
# MAIL_NEXUS_YARA_RULES_DIR=rules
# MAIL_NEXUS_ATTACHMENT_SCAN_DIR=/tmp
# MAIL_NEXUS_LAYER_TIMEOUT_SECONDS=0.20

# VirusTotal and Redis caching (optional)
# VIRUSTOTAL_API_KEY=
# REDIS_URL=redis://localhost:6379/0

# LLM Threat Advisory Provider: 'ollama' (default) or 'groq'
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=llama3.2:3b
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# MAIL_NEXUS_LLM_TIMEOUT_SECONDS=3

# Geolocation & IP Intelligence
# MAIL_NEXUS_IP_INTELLIGENCE_PATH=data/ip_intelligence.csv
# MAIL_NEXUS_GEOLOCATION_URL=https://ipwho.is
# IPINFO_TOKEN=
# MAIL_NEXUS_GEOLOCATION_TIMEOUT_SECONDS=1.5
# MAIL_NEXUS_TRUSTED_RECEIVED_HOSTS=

# Tenant & CORS settings
# MAIL_NEXUS_COLLEGE_DOMAINS=college-example.edu.in,cgc.edu.in,edushield1.in,edushiel1.in
# MAIL_NEXUS_CORS_ORIGINS=https://mail.edushield1.in,https://organization-a.edushield1.in,https://organization-b.edushield1.in,https://soc.edushield1.in,http://localhost:3000,http://localhost:3001

